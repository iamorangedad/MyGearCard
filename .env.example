# 复制为 .env。这些值只在部署时生效，页面里不能修改。
# 外部图像接口（OpenAI 及兼容服务：SiliconFlow、智谱等）
MYGEAR_EXTERNAL_IMAGE_BASE_URL=https://api.openai.com/v1
MYGEAR_EXTERNAL_IMAGE_MODEL=dall-e-3
MYGEAR_EXTERNAL_IMAGE_API_KEY=

# 外部视觉/文案接口，用来识别照片并写招式
MYGEAR_EXTERNAL_VISION_BASE_URL=https://api.openai.com/v1
MYGEAR_EXTERNAL_VISION_MODEL=gpt-4o-mini
MYGEAR_EXTERNAL_VISION_API_KEY=

# 本地出图。backend=a1111 时地址是 WebUI 根路径；backend=openai 时地址需带 /v1
MYGEAR_LOCAL_IMAGE_BACKEND=a1111
MYGEAR_LOCAL_IMAGE_BASE_URL=http://127.0.0.1:7860
MYGEAR_LOCAL_IMAGE_MODEL=
MYGEAR_LOCAL_IMAGE_API_KEY=
MYGEAR_LOCAL_IMAGE_STEPS=20
MYGEAR_LOCAL_IMAGE_WIDTH=512
MYGEAR_LOCAL_IMAGE_HEIGHT=768

# 单卡价格和运费，单位是分。2900 = 29.00 元
MYGEAR_CARD_PRICE_CENTS=2900
MYGEAR_SHIPPING_CENTS=1200

# 本地视觉，常见是 Ollama 的 OpenAI 兼容接口
MYGEAR_LOCAL_VISION_BASE_URL=http://127.0.0.1:11434/v1
MYGEAR_LOCAL_VISION_MODEL=llava
MYGEAR_LOCAL_VISION_API_KEY=ollama
